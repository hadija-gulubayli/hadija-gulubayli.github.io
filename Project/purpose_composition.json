{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Mission Purpose Composition of Active Space Objects (2025)",
    "subtitle": [
      "Top 50 countries • Shares within each country"
    ],
    "anchor": "start"
  },

  "width": 470,
  "height": 420,

  "padding": { "left": 35, "top": 10, "right": 10, "bottom": 10 },

  "data": {
    "url": "https://raw.githubusercontent.com/hadija-gulubayli/hadija-gulubayli.github.io/refs/heads/main/Data/unoosa_active_purpose_composition_top50.csv",
    "format": { "type": "csv" }
  },

  "params": [
    {
      "name": "hoverCountry",
      "select": {
        "type": "point",
        "fields": ["country"],
        "on": "mouseover",
        "clear": "mouseout"
      }
    }
  ],

  "transform": [
    {
      "joinaggregate": [
        { "op": "sum", "field": "active_objects", "as": "total_active" }
      ],
      "groupby": ["country"]
    },
    { "calculate": "datum.active_objects / datum.total_active", "as": "share" }
  ],

  "mark": { "type": "bar", "orient": "horizontal" },

  "encoding": {
    "y": {
      "field": "country",
      "type": "nominal",
      "sort": { "field": "total_active", "order": "ascending" },
      "title": null,
      "axis": {
        "labelLimit": 220,
        "ticks": false,
        "domain": false
      }
    },

    "x": {
      "aggregate": "sum",
      "field": "share",
      "type": "quantitative",
      "title": "Share of active objects",
      "axis": {
        "format": "%",
        "tickCount": 5,
        "grid": true,
        "gridOpacity": 0.25
      },
      "scale": { "domain": [0, 1] }
    },

    "color": {
      "field": "purpose_class",
      "type": "nominal",
      "legend": {
        "title": "Mission purpose",
        "orient": "right",
        "symbolType": "square",
        "symbolSize": 140
      },
      "scale": {
        "range": ["#8ECAE6", "#219EBC", "#3A5BA0", "#6A4C93", "#C77D00", "#6C757D"]
      }
    },

    "opacity": {
      "condition": { "param": "hoverCountry", "value": 1 },
      "value": 0.18
    },

    "tooltip": [
      { "field": "country", "type": "nominal", "title": "Country" },
      { "field": "purpose_class", "type": "nominal", "title": "Purpose" },
      { "field": "share", "type": "quantitative", "title": "Share within country", "format": ".1%" },
      { "field": "active_objects", "type": "quantitative", "title": "Active objects (count)", "format": "," }
    ]
  },

  "config": {
    "background": "white",
    "view": { "stroke": "transparent" },

    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#1b1b1b",
      "titleColor": "#1b1b1b"
    },

    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#1b1b1b",
      "titleColor": "#1b1b1b"
    },

    "title": {
      "fontSize": 15,
      "subtitleFontSize": 12,
      "color": "#111",
      "subtitleColor": "rgba(0,0,0,0.65)"
    }
  }
}
