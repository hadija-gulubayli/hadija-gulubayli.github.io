{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Cumulative Objects Launched into Outer Space (2025)",
    "subtitle": "Source: UNOOSA • Active and inactive objects • Click legend to filter",
    "anchor": "start"
  },
  "width": 650,
  "height": 420,
  "projection": { "type": "equalEarth" },

  "data": {
    "url": "https://raw.githubusercontent.com/EconomicsObservatory/courses/main/datasets/advanced/map_world.geojson",
    "format": { "type": "json", "property": "features" }
  },

  "transform": [
    {
      "lookup": "properties.ISO3",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/hadija-gulubayli/hadija-gulubayli.github.io/refs/heads/main/Data/unoosa_cumulative.csv",
          "format": { "type": "csv" }
        },
        "key": "iso3",
        "fields": ["country", "total_launches", "active_launches"]
      }
    },
    {
      "calculate": "isValid(datum.total_launches) ? toNumber(datum.total_launches) : 0",
      "as": "total"
    },
    {
      "calculate": "isValid(datum.active_launches) ? toNumber(datum.active_launches) : 0",
      "as": "active"
    },
    { "calculate": "datum.total - datum.active", "as": "inactive" },
    {
      "calculate": "datum.total == 0 ? null : datum.total <= 50 ? '1–50' : datum.total <= 100 ? '51–100' : datum.total <= 200 ? '101–200' : datum.total <= 500 ? '201–500' : datum.total <= 1000 ? '501–1,000' : datum.total <= 2000 ? '1,001–2,000' : datum.total <= 5000 ? '2,001–5,000' : '5,001+'",
      "as": "bucket"
    }
  ],

  "params": [
    {
      "name": "legendSelect",
      "select": { "type": "point", "fields": ["bucket"] },
      "bind": "legend",
      "empty": "all"
    },
    {
      "name": "hover",
      "select": { "type": "point", "on": "mouseover", "clear": "mouseout" }
    }
  ],

  "mark": { "type": "geoshape", "strokeWidth": 0.35 },

  "encoding": {
    "color": {
      "condition": {
        "test": "datum.total == 0",
        "value": "rgba(255,255,255,0.02)"
      },
      "field": "bucket",
      "type": "nominal",
      "legend": {
        "title": "Cumulative objects",
        "orient": "right",
        "labelLimit": 140,
        "symbolType": "square"
      },
      "scale": {
        "domain": [
          "1–50",
          "51–100",
          "101–200",
          "201–500",
          "501–1,000",
          "1,001–2,000",
          "2,001–5,000",
          "5,001+"
        ],
        "range": [
          "#EAF3FF",
          "#D6E7FF",
          "#B7D7FF",
          "#8FC0FF",
          "#5FA3FF",
          "#2F7FE6",
          "#1F4FB8",
          "#2B1A7A"
        ]
      }
    },

    "stroke": {
      "condition": { "test": "datum.total == 0", "value": "rgba(0,0,0,0.03)" },
      "value": "rgba(0,0,0,0.14)"
    },

    "opacity": {
      "condition": { "param": "legendSelect", "value": 1 },
      "value": 0.18
    },

    "strokeWidth": {
      "condition": { "param": "hover", "value": 1.1 },
      "value": 0.35
    },

    "tooltip": [
      { "field": "properties.COUNTRY", "type": "nominal", "title": "Country" },
      { "field": "total", "type": "quantitative", "title": "Total objects", "format": "," },
      { "field": "active", "type": "quantitative", "title": "Active", "format": "," },
      { "field": "inactive", "type": "quantitative", "title": "Inactive", "format": "," }
    ]
  },

  "config": {
    "background": "white",
    "view": { "stroke": null },
    "title": {
      "fontSize": 15,
      "subtitleFontSize": 12,
      "color": "#111",
      "subtitleColor": "rgba(0,0,0,0.65)"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "padding": 8
    },
    "axis": { "labelFontSize": 11, "titleFontSize": 12 }
  }
}
